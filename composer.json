{
    "type": "library",
    "name": "youtrust/zdd-message-bundle",
    "description": "Assert Zero Downtime Deployment compliance for messages",
    "license": "MIT",
    "keywords": ["dev", "zdd"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "symfony/console": "^7.4|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.1",
        "symfony/browser-kit": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0",
        "symfony/messenger": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Youtrust\\ZddMessageBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Youtrust\\ZddMessageBundle\\Tests\\": "tests/"
        }
    }
}
